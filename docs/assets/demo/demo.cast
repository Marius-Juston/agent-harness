[0.3, "o", "\u001b[2J\u001b[H\u001b[1;34m1/6 ▸\u001b[0m \u001b[1mCreate a project from the template\u001b[0m\r\n\r\n"]
[0.7, "o", "\u001b[36m~\u001b[0m $ "]
[0.805, "o", "uvx "]
[1.015, "o", "copier "]
[1.155, "o", "copy "]
[2.205, "o", "gh:Marius-Juston/agent-harness "]
[2.555, "o", "my-project"]
[2.905, "o", "\r\n"]
[2.965, "o", "🎤 Project name (a Python distribution name, e.g. my-project)\r\n"]
[3.025, "o", "   my-project\r\n"]
[3.085, "o", "🎤 One sentence on what the project is for\r\n"]
[3.145, "o", "   A project worked on by many Claude Code agents.\r\n"]
[3.205, "o", "🎤 Minimum Python version\r\n"]
[3.265, "o", "   3.13\r\n"]
[3.325, "o", "\u001b[90mCopying from template version 0.1.13\u001b[0m\r\n"]
[3.385, "o", "\u001b[32m    create\u001b[0m  CLAUDE.md  .claude/  .devkit/  .github/  docs/  tests/  pyproject.toml ...\r\n"]
[3.985, "o", "\r\n"]
[4.385, "o", "\u001b[36m~\u001b[0m $ "]
[4.455, "o", "cd "]
[4.805, "o", "my-project"]
[5.155, "o", "\r\n"]
[7.355, "o", "\u001b[2J\u001b[H\u001b[1;34m2/6 ▸\u001b[0m \u001b[1mOne command sets up git, uv, hooks and the plugin, then says what is left\u001b[0m\r\n\r\n"]
[7.755, "o", "\u001b[36m~/my-project\u001b[0m $ "]
[7.825, "o", "uv "]
[7.93, "o", "run "]
[8.035, "o", "dev "]
[8.21, "o", "setup"]
[8.56, "o", "\r\n"]
[8.62, "o", "\u001b[32mok\u001b[0m   git init (branch main)\r\n"]
[8.68, "o", "\u001b[32mok\u001b[0m   uv sync\r\n"]
[8.74, "o", "\u001b[32mok\u001b[0m   generated references (dev docs)\r\n"]
[8.8, "o", "\u001b[32mok\u001b[0m   git rerere (replays conflict resolutions across worktrees)\r\n"]
[8.86, "o", "\u001b[32mok\u001b[0m   pre-commit hooks (prek)\r\n"]
[8.92, "o", "\u001b[32mok\u001b[0m   plugin marketplace Marius-Juston/agent-harness@v0.1.13\r\n"]
[8.98, "o", "\u001b[32mok\u001b[0m   plugin harness-ops@agent-harness\r\n"]
[9.04, "o", "\r\n"]
[9.1, "o", "Still to do by hand:\r\n"]
[9.16, "o", "- once per repository: create it on GitHub (`gh repo create`), then `uv run dev board init`\r\n"]
[9.22, "o", "\u001b[32mok\u001b[0m   gh authenticated\r\n"]
[9.28, "o", "\u001b[32mok\u001b[0m   MCP server playwright connected\r\n"]
[9.34, "o", "\u001b[32mok\u001b[0m   installed plugin is the pinned release's build\r\n"]
[9.94, "o", "\r\n"]
[12.14, "o", "\u001b[2J\u001b[H\u001b[1;34m3/6 ▸\u001b[0m \u001b[1mThe board is GitHub issues, and every item has a measurable DONE WHEN\u001b[0m\r\n\r\n"]
