[26.18, "o", "\u001b[2J\u001b[H\u001b[1;34m4/6 ▸\u001b[0m \u001b[1mStart Claude Code, then paste the /goal prompt from docs/SESSION.md\u001b[0m\r\n\r\n"]
[26.58, "o", "\u001b[36m~/my-project\u001b[0m $ "]
[26.79, "o", "claude"]
[27.14, "o", "\r\n"]
[27.2, "o", "\u001b[35m✻\u001b[0m \u001b[1mWelcome to Claude Code\u001b[0m   \u001b[90mplugin harness-ops loaded\u001b[0m\r\n"]
[27.26, "o", "\u001b[90mSessionStart hook: the handoff, the board and this machine\u001b[0m\r\n"]
[27.32, "o", "  ## Board   next startable:\r\n"]
[27.38, "o", "  \u001b[1;33m#1\u001b[0m   P1 build ready   GET /health returns the version\r\n"]
[27.44, "o", "  ## This machine   gate idle · 21 GB free · quota: 12% of weekly used, cap 95%\r\n"]
[28.04, "o", "\r\n"]
[28.44, "o", "\u001b[1m>\u001b[0m "]
[28.615, "o", "/goal "]
[28.72, "o", "You "]
[28.825, "o", "are "]
[28.93, "o", "the "]
[29.07, "o", "lead "]
[29.175, "o", "for "]
[29.315, "o", "this "]
[29.665, "o", "repository "]
[29.735, "o", "on "]
[29.875, "o", "this "]
[30.155, "o", "machine: "]
[30.365, "o", "follow "]
[30.47, "o", "the "]
[31.03, "o", "harness-ops:lead "]
[31.135, "o", "..."]
[31.485, "o", "\r\n"]
[31.545, "o", "\u001b[90m(the full prompt, with its stop rule, is in docs/SESSION.md)\u001b[0m\r\n"]
[32.145, "o", "\r\n"]
[34.345, "o", "\u001b[2J\u001b[H\u001b[1;34m5/6 ▸\u001b[0m \u001b[1mThe lead dispatches a worker per issue; only `dev integrate` merges, after re-gating\u001b[0m\r\n\r\n"]
[34.405, "o", "⏺ Bash(uv run dev board next)\r\n"]
[34.465, "o", "  ⎿  \u001b[1;33m#1\u001b[0m  P1 build ready  GET /health returns the version  [P1, unblocks 0]\r\n"]
[34.525, "o", "\r\n"]
[34.585, "o", "⏺ \u001b[35mharness-ops:builder\u001b[0m(#1 GET /health returns the version)\r\n"]
[34.645, "o", "  ⎿  own worktree 1-health · test first · uv run dev check \u001b[32mpassed\u001b[0m\r\n"]
[34.705, "o", "     https://github.com/you/my-project/pull/2\r\n"]
[34.765, "o", "     \u001b[1;33m#1\u001b[0m status:review\r\n"]
[34.825, "o", "\r\n"]
[34.885, "o", "⏺ \u001b[35mharness-ops:reviewer\u001b[0m(PR #2)\r\n"]
[34.945, "o", "  ⎿  approved: DONE WHEN met (tests/test_health.py passes), no findings\r\n"]
[35.005, "o", "\r\n"]
[35.065, "o", "⏺ Bash(uv run dev integrate 2)\r\n"]
[35.125, "o", "  ⎿  \u001b[90mre-gates PR #2 merged onto main in a throwaway worktree\u001b[0m\r\n"]
[35.185, "o", "     ok   tests: 12 checked, 0 problem(s)\r\n"]
[35.245, "o", "     RESULT: passed (19 s)\r\n"]
[35.305, "o", "     \u001b[32mRESULT: merged PR #2\u001b[0m\r\n"]
[35.365, "o", "\r\n"]
[35.425, "o", "⏺ Nothing startable is left; docs/HANDOFF.md is current. Done.\r\n"]
[36.025, "o", "\r\n"]
[38.225, "o", "\u001b[2J\u001b[H\u001b[1;34m6/6 ▸\u001b[0m \u001b[1mThe issue was closed by a gated PR, with no merge done by hand\u001b[0m\r\n\r\n"]
[38.625, "o", "\u001b[36m~/my-project\u001b[0m $ "]
[38.695, "o", "gh "]
[38.87, "o", "issue "]
[39.01, "o", "list "]
[39.255, "o", "--state "]
[39.465, "o", "closed"]
[39.815, "o", "\r\n"]
[39.875, "o", "\u001b[1;33m#1\u001b[0m  \u001b[90mCLOSED\u001b[0m  GET /health returns the version   P1, type:build   less than a minute ago\r\n"]
[40.475, "o", "\r\n"]
[40.535, "o", "\u001b[1mYou:\u001b[0m      copier copy  →  dev setup  →  board new  →  claude + /goal\r\n"]
[40.595, "o", "\u001b[1mHarness:\u001b[0m  builder (own worktree)  →  gated PR  →  reviewer  →  integrate re-gates and merges\r\n"]
[40.655, "o", "\r\n"]
[40.715, "o", "\u001b[90mMore prompts: docs/SESSION.md and docs/PROMPTS.md in your new project\u001b[0m\r\n"]
[41.315, "o", "\r\n"]
