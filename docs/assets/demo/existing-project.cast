[65.44, "o", "\u001b[2J\u001b[H\u001b[1;34m5/5 ▸\u001b[0m \u001b[1mFrom here it is the same loop as a new project\u001b[0m\r\n\r\n"]
[66.02, "o", "\u001b[1mOnce:\u001b[0m       gh repo create (if it is not on GitHub yet)  →  uv run dev board init\r\n"]
[66.1, "o", "\u001b[1mEach task:\u001b[0m  uv run dev board new ... --done \"...\"\r\n"]
[66.18, "o", "\u001b[1mThen:\u001b[0m       claude  →  paste the /goal prompt from docs/SESSION.md\r\n"]
[66.26, "o", "\r\n"]
[66.34, "o", "\u001b[90mThe template's lint and test settings now cover your code: fix what the gate finds, or set\u001b[0m\r\n"]
[66.42, "o", "\u001b[90mthem in pyproject.toml; the gate never lowers a check to pass.\u001b[0m\r\n"]
