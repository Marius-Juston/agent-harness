# Editor defaults that match the formatters the gate runs (ruff: 4 spaces, 120 columns). https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,sh,jinja}]
indent_size = 2

[*.py]
max_line_length = 120

[*.md]
max_line_length = 120
