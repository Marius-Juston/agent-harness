{
  "description": "agent-harness guards (fail closed): uv only, reuse gates on uv add, no pushes to main, no destructive git or rm, no secrets, outlines for long reads, ruff at edit time, resource gates before spawns, a completion gate on builders, worktrees beside the repository, orientation at session start",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/session_brief.sh", "timeout": 45 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/guard_bash.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/uv_add_guard.py",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "Bash|Read",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/read_guard.py", "timeout": 10 }]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/edit_guard.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/spawn_guard.sh",
            "timeout": 10,
            "statusMessage": "Checking the weekly quota before spawning"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/spawn_guard.sh",
            "timeout": 330,
            "statusMessage": "Waiting for free memory before a heavy agent starts"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "builder$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/completion_gate.py",
            "timeout": 240,
            "statusMessage": "Checking the builder's tree, gate and PR before it stops"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/lint_after_edit.py", "timeout": 30 }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/worktree_create.sh", "timeout": 120 }
        ]
      }
    ]
  },
  "modules": ["./register.tsx"]
}
