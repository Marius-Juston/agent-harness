[project]
name = "{{ project_name }}"
version = "0.0.1"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
dependencies = []

[dependency-groups]
# The harness: the `dev` command (gate, board, navigation, research checks) and the gate's pinned tools.
# PyPI's `agent-harness` is an unrelated project, so the requirement names the git tag itself: tools that skip
# [tool.uv.sources] (`--no-sources`, pip, an exported requirements file) still never resolve it from PyPI.
dev = ["agent-harness @ git+https://github.com/Marius-Juston/agent-harness@{{ harness_ref }}"]

[tool.uv]
package = false
default-groups = ["dev"]

[tool.uv.sources]
{%- if harness_path %}
agent-harness = { path = "{{ harness_path }}", editable = true }
{%- else %}
agent-harness = { git = "https://github.com/Marius-Juston/agent-harness", tag = "{{ harness_ref }}" }
{%- endif %}

# What this project changes in the harness defaults (devkit/config.py in agent-harness lists every key).
[tool.devkit]
# The harness-ops plugin provides the agents and skills; set false once the project has its own in .claude/.
surface_optional = true
quota_cap = 95
# Commands integrate runs in the merged tree after `uv run dev docs`, committing what they change: for a file no merge
# can combine, such as a line hashing other files. Mark that file `merge=devkit-generated` in .gitattributes too.
# regenerate = [["uv", "run", "python", "scripts/rehash.py"]]

# Import contracts the gate's arch stage keeps (`uv run dev arch` reports them); none until you declare one.
# [[tool.devkit.arch.contracts]]
# name = "{{ project_name | replace('-', '_') }} modules form no import cycle"
# type = "acyclic_siblings"
# ancestors = ["{{ project_name | replace('-', '_') }}"]
#
# [[tool.devkit.arch.contracts]]
# name = "only the entry point imports the CLI"
# type = "forbidden"
# source_modules = ["{{ project_name | replace('-', '_') }}.*"]
# forbidden_modules = ["{{ project_name | replace('-', '_') }}.cli"]

# `uv run dev integrate --local-ci` (no Actions minutes): what stands in for each required check. `check` runs, after
# the gate, each other `run:` step of .github/workflows/gate.yml's check job, the same text in the same order; a
# multi-line step runs as itself under bash -e, as Actions runs it. Change one, change the other.
[tool.devkit.local_ci]
check = [
    ["uv", "run", "dev", "cite-check"],
    ["uvx", "prek@0.5.3", "run", "-c", ".pre-commit-config.yaml", "--hook-stage", "manual", "gitleaks-history", "--all-files"],
    ["uv", "audit", "--locked", "--preview-features", "audit-command"],
    ["env", "RUNNER_TEMP={tmpdir}", "bash", "-ec", '''
rules="$RUNNER_TEMP/semgrep-rules"
mkdir -p "$rules"
curl -fsSL --retry 3 https://codeload.github.com/semgrep/semgrep-rules/tar.gz/a5ad1714f00c9f7fde980cab0ea1d6dc6d414fd2 \
  | tar -xz -C "$rules" --strip-components=1
uvx semgrep@1.186.0 scan --error --metrics=off --disable-version-check \
  --config "$rules/bash" --config "$rules/yaml/github-actions" --config "$rules/dockerfile" \
  --config "$rules/generic/ci" .
'''],
    ["uv", "export", "--frozen", "--format", "cyclonedx1.5", "--preview-features", "sbom-export", "--quiet", "--output-file", "sbom.cdx.json"],
]

[tool.devkit.plugins]
"harness-ops@agent-harness" = "Marius-Juston/agent-harness@{{ harness_ref }}"
"astral@astral-sh" = "astral-sh/claude-code-plugins"

[tool.ruff]
line-length = 120
target-version = "py{{ python_version | replace('.', '') }}"

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "SIM", "RUF", "S"]
ignore = ["E501", "RUF001", "RUF002", "RUF003"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"] # pytest asserts
"docs/research/_scratch/**" = ["S"] # throwaway research probe scripts, never imported or shipped

# The gate's ty stage counts diagnostics against [types] max_diagnostics of .devkit/ratchets.toml; the same probe
# scripts are not type checked. Semgrep still scans them: they are run, sometimes with live keys.
[tool.ty.src]
exclude = ["docs/research/_scratch/"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q --strict-markers -p no:cacheprovider"
xfail_strict = true  # an xfail test that starts passing fails the run
markers = [
    "slow: long-running tests (run with `uv run dev test --slow`)",
    "live: needs network or a model; never in the default gate",
]
