[project]
name = "{{ project_name }}"
version = "0.0.1"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
dependencies = []

[dependency-groups]
# The harness: the `dev` command (gate, board, navigation, research checks) and the gate's pinned tools.
# PyPI's `agent-harness` is an unrelated project, so the requirement names the git tag itself: tools that skip
# [tool.uv.sources] (`--no-sources`, pip, an exported requirements file) still never resolve it from PyPI.
dev = ["agent-harness @ git+https://github.com/Marius-Juston/agent-harness@{{ harness_ref }}"]

[tool.uv]
package = false
default-groups = ["dev"]

[tool.uv.sources]
{%- if harness_path %}
agent-harness = { path = "{{ harness_path }}", editable = true }
{%- else %}
agent-harness = { git = "https://github.com/Marius-Juston/agent-harness", tag = "{{ harness_ref }}" }
{%- endif %}

# What this project changes in the harness defaults (devkit/config.py in agent-harness lists every key).
[tool.devkit]
# The harness-ops plugin provides the agents and skills; set false once the project has its own in .claude/.
surface_optional = true
quota_cap = 95
# Commands integrate runs in the merged tree after `uv run dev docs`, committing what they change: for a file no merge
# can combine, such as a line hashing other files. Mark that file `merge=devkit-generated` in .gitattributes too.
# regenerate = [["uv", "run", "python", "scripts/rehash.py"]]

[tool.devkit.plugins]
"harness-ops@agent-harness" = "Marius-Juston/agent-harness@{{ harness_ref }}"
"astral@astral-sh" = "astral-sh/claude-code-plugins"

[tool.ruff]
line-length = 120
target-version = "py{{ python_version | replace('.', '') }}"

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "SIM", "RUF", "S"]
ignore = ["E501", "RUF001", "RUF002", "RUF003"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"] # pytest asserts
"docs/research/_scratch/**" = ["S"] # throwaway research probe scripts, never imported or shipped

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q --strict-markers -p no:cacheprovider"
xfail_strict = true  # an xfail test that starts passing fails the run
markers = [
    "slow: long-running tests (run with `uv run dev test --slow`)",
    "live: needs network or a model; never in the default gate",
]
